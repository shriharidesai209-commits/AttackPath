# ==============================================================================
# AttackPath — Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and fill in your environment-specific credentials.
# NEVER commit the actual '.env' file to source control.
# ==============================================================================

# Application Environment
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# FalkorDB Database Configuration
# Provide details for your live FalkorDB instance (e.g. FalkorDB Cloud or self-hosted)
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_SSL=false
FALKORDB_TIMEOUT_MS=5000
FALKORDB_BASELINE_GRAPH=attackpath_baseline

# Pluggable Agent / LLM Provider (Optional)
# If set to 'none' or left empty, the built-in Deterministic Rule Explainer is used.
LLM_PROVIDER=none
OPENAI_API_KEY=
GEMINI_API_KEY=
